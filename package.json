{
	"name": "@misiki/kitcommerce-core",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"svelte": "./dist/types/index.js"
		},
		"./services": {
			"types": "./dist/services/index.d.ts",
			"svelte": "./dist/services/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"svelte": "./dist/utils/index.js"
		},
		"./logic": {
			"types": "./dist/logic/index.d.ts",
			"svelte": "./dist/logic/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"svelte": "./dist/hooks/index.js"
		},
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"svelte": "./dist/stores/index.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./composables": {
			"types": "./dist/composables/index.d.ts",
			"svelte": "./dist/composables/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@internationalized/date": "^3.7.0",
		"@misiki/litekart-connector": "^2.0.26",
		"@stripe/stripe-js": "^9.0.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"bits-ui": "^2.16.3",
		"embla-carousel-svelte": "^8.6.0",
		"fuse.js": "^7.1.0",
		"paneforge": "^0.0.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"shadcn-svelte": "^0.14.0",
		"stripe": "^17.6.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"zod": "^3.24.1"
	},
	"keywords": [
		"svelte"
	]
}
