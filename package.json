{
	"name": "@misiki/kitcommerce-core",
	"version": "0.1.57",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"p": "npm run build && npm publish --access public",
		"test": "bun run src/lib/utils/sort.spec.ts && bun run src/lib/utils/payment-reference.spec.ts && bun run src/lib/utils/seo.spec.ts"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js",
			"svelte": "./dist/components/index.js",
			"default": "./dist/components/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js",
			"svelte": "./dist/types/index.js",
			"default": "./dist/types/index.js"
		},
		"./services": {
			"types": "./dist/services/index.d.ts",
			"import": "./dist/services/index.js",
			"svelte": "./dist/services/index.js",
			"default": "./dist/services/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js",
			"svelte": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		},
		"./logic": {
			"types": "./dist/logic/index.d.ts",
			"import": "./dist/logic/index.js",
			"svelte": "./dist/logic/index.js",
			"default": "./dist/logic/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js",
			"svelte": "./dist/hooks/index.js",
			"default": "./dist/hooks/index.js"
		},
		"./load-functions": {
			"types": "./dist/load-functions/index.d.ts",
			"import": "./dist/load-functions/index.js",
			"svelte": "./dist/load-functions/index.js",
			"default": "./dist/load-functions/index.js"
		},
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"import": "./dist/stores/index.js",
			"svelte": "./dist/stores/index.js",
			"default": "./dist/stores/index.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./request-handlers": {
			"types": "./dist/request-handlers/index.d.ts",
			"import": "./dist/request-handlers/index.js",
			"svelte": "./dist/request-handlers/index.js",
			"default": "./dist/request-handlers/index.js"
		},
		"./composables": {
			"types": "./dist/composables/index.d.ts",
			"import": "./dist/composables/index.js",
			"svelte": "./dist/composables/index.js",
			"default": "./dist/composables/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@misiki/litekart-connector": "^2.0.31"
	},
	"devDependencies": {
		"@internationalized/date": "^3.7.0",
		"@misiki/litekart-connector": "^2.0.31",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"paneforge": "^0.0.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"shadcn-svelte": "^0.14.0",
		"stripe": "^17.6.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@ayushtripathy/tracebox": "^0.0.3",
		"@stripe/stripe-js": "^9.0.0",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-svelte": "^8.6.0",
		"fuse.js": "^7.1.0",
		"jsdom": "^29.0.2",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"zod": "^3.24.1"
	}
}
